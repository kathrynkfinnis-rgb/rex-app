# Oct 16, security review (F22) — the site sent only two of these.
#
# Content-Security-Policy is the one that earns its keep: with no script-src,
# any injection anywhere on the origin could read the admin session token out
# of localStorage. The share pages carry no script at all, and admin.html's
# was moved to /admin.js in the same change, so 'self' is achievable here
# rather than the 'unsafe-inline' that usually gets written instead.
#
# img-src has to allow https: generally — a share page shows whatever photo
# the Rex carries, which may be Supabase storage, Google Places or a book
# cover. isSafeImage already constrains those to https in the Functions.
#
# frame-ancestors 'none' is the one that matters for /admin.html: without it
# the sign-in form can be framed by any site and clicked through.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://api.fontshare.com; font-src https://api.fontshare.com; img-src 'self' https: data:; connect-src 'self' https://uhpzkbkwxcgqfxmlyktj.supabase.co; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'self'

/admin.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# Oct 5 — Universal Links. Apple fetches this file and refuses it unless it is
# served as JSON. It has no extension on purpose — that is Apple's spec, not an
# oversight — so the type has to be set here rather than inferred.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600
